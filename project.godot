; Engine configuration file.
; Projeto Mutantes - protótipo jogável (greybox)

config_version=5

[application]

config/name="Projeto Mutantes - Protótipo"
config/description="Greybox jogável da fase-piloto Posto Vigia-01."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="herois"
3d_physics/layer_3="inimigos"
3d_physics/layer_4="vaos"
3d_physics/layer_5="passarela"

[rendering]

anti_aliasing/quality/msaa_3d=2
